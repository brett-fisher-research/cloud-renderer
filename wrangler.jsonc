// Cloudflare Workers config: serves the web build in dist/ at clouds.brettfisher.dev.
// Build with `trunk build --release`, then deploy with `npx wrangler deploy`.
{
  "name": "clouds",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "clouds.brettfisher.dev", "custom_domain": true }],
  "workers_dev": true
}
